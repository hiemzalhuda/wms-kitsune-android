<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fino_bg"
    android:padding="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stok Gudang"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/fino_text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <EditText
            android:id="@+id/etCari"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Cari kode / nama..."
            android:background="@drawable/bg_input"
            android:padding="12dp" />
        <Button
            android:id="@+id/btnCari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/fino_primary" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvInfoStok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fino_muted"
        android:layout_marginBottom="6dp" />
    <ProgressBar
        android:id="@+id/loadStok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/fino_primary"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStok"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
