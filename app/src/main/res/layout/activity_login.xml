<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fino_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Topbar hijau ala web -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fino_primary"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAPFA Food"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="So Good Food Manufacturing"
                android:textColor="#E8F3E0" />
        </LinearLayout>
        <!-- Kartu login hijau ala web -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_margin="20dp"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masuk WMS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/fino_text"
                android:layout_marginBottom="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USERNAME / REGU"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/fino_muted" />
            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ketik nama akun..."
                android:inputType="text"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/fino_muted" />
            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ketik sandi keamanan..."
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MASUK SISTEM"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/fino_primary" />
            <ProgressBar
                android:id="@+id/loadLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/fino_primary"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="atau buka mode web lama →"
                android:textColor="@color/fino_primary"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
